# Copy this file to .streamlit/secrets.toml for local runs, or paste its
# contents into the deployed app's Secrets settings on Streamlit Community
# Cloud. Never commit the real secrets.toml — it's gitignored on purpose.

# 25-30 Grok API keys, rotated with automatic failover (see
# zepto_discovery/grok_client.py). Order doesn't matter.
GROK_API_KEYS = [
    "xai-REPLACE_ME_1",
    "xai-REPLACE_ME_2",
]

# Supabase project credentials (Storage), used to persist tagged reviews
# and per-timeframe themes/synthesis across app restarts — Streamlit
# Community Cloud's local disk does not survive a sleep/redeploy.
# Find these in your Supabase project's Settings -> API page. You also
# need to create a Storage bucket named "zepto-discovery-data" in that
# project (see zepto_discovery/external_store.py).
SUPABASE_URL = "https://REPLACE_ME.supabase.co"
SUPABASE_KEY = "REPLACE_ME_service_or_anon_key"
